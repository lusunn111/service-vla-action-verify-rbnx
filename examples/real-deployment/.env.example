ROBONIX_SERVICE_PYTHON=/absolute/path/to/vla-service/bin/python
RBNX_RUNTIME_DIR=/absolute/path/to/runtime/vla-action-decision
ROBONIX_PROVIDER_BIND_HOST=127.0.0.1
ROBONIX_ADVERTISE_HOST=127.0.0.1
VLA_TARGET_CHECKPOINT=/absolute/path/to/openvla-libero-goal
VLA_DRAFTER_CHECKPOINT=/absolute/path/to/drafter-libero-goal
ROBONIX_VALIDATION_INPUT_ROOT=/absolute/path/to/validation/inputs
VLA_CUDA_VISIBLE_DEVICES=1
HF_HOME=/absolute/path/to/cache/huggingface
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
TOKENIZERS_PARALLELISM=false
PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python
